# -----------------------------------------------------------------------------
# Store Hub — production settings for deploy/docker-compose.yml.
# Copy to deploy/.env and fill in. NEVER commit deploy/.env.
# No quotes needed. Avoid "$" in values (or wrap the whole value in '...').
# -----------------------------------------------------------------------------

# --- Addresses ---------------------------------------------------------------
# Each needs a DNS A record pointing at this server. The Hub is the operator
# app; the Vetrina's address serves the Vetrina only. Each address has its own
# sign-in, and who may open which is set in Authelia: list both addresses in
# Authelia's config/configuration.yml too (/srv/authelia, docs/auth.md).
HUB_HOST=hub.resellpiacenza.shop
VETRINA_HOST=vetrina.resellpiacenza.shop

# The Docker network your caddy-docker-proxy container watches (the one named
# in its CADDY_INGRESS_NETWORKS).
CADDY_NETWORK=caddy

# This stack's name on the server (containers, image, database volume).
# Leave it for the first shop; a second shop on the same server needs its own.
# COMPOSE_PROJECT_NAME=store-hub

# --- Sign-in (required) ------------------------------------------------------
# Authelia signs people in, in front of the app (docs/auth.md). Caddy adds
# this secret to every request it lets through, and the app refuses requests
# without it: nothing that reaches the app another way, such as another
# container on Caddy's network, can claim to be someone.
# Generate it once:  openssl rand -hex 32
AUTH_PROXY_SECRET=

# --- Database (required) -----------------------------------------------------
# Generate it once:  openssl rand -hex 24
# Letters and digits only — it goes inside a URL. Postgres takes it when the
# database is first created; changing it here later is not enough.
POSTGRES_PASSWORD=

# --- WooCommerce REST: the Sync tab and the Vetrina --------------------------
# Read/Write key of a user with manage_woocommerce (the same as today).
WOO_BASE_URL=https://resellpiacenza.shop
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=

# --- WordPress: the site's navigation menus (Vetrina › Menu) -----------------
# An administrator and an Application Password of theirs (Users › Profile ›
# Application Passwords). Optional; see docs/menus.md.
# WP_APP_USER=
# WP_APP_PASSWORD=

# --- The automatic sync: set in the Hub, not here ---------------------------
# How often the store follows the supplier feed, when the full daily sync
# runs, the safety limits, the healthchecks.io alerts: Feeds tab › Automatic
# sync › Settings. A change saved there applies within a minute — no restart.
# If this file still sets AUTO_SYNC, SCHEDULER_TIMES, SCHEDULER_FEEDS_MINUTES or
# the like, they are only the starting values until the first save; the Feeds
# tab lists them, and then they can be deleted from here.

# --- Optional: uncomment the ones you use ------------------------------------
# Don't leave a line with nothing after "=": uncomment it with a value or not
# at all. Every variable is explained in the repo's .env.example.
# KICKS_SECRET=your-kicksdb-api-key
# GS_FEED_URL=https://www.goldensneakers.net/api/assortment-flat/?vat=22&markup=...
# GS_FEED_TOKEN=your-goldensneakers-bearer-token
# CRON_SECRET=only-if-an-external-scheduler-calls-/api/cron
# HUB_API_TOKENS=assistant:openssl-rand-hex-32:read+propose,phone:openssl-rand-hex-32:read+confirm+undo
# HUB_API_TOKEN=only-if-scripts-call-/api/v1-(openssl-rand-hex-32)
